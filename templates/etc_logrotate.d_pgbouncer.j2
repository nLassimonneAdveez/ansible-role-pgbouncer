# {{ ansible_managed }}

{{ pgbouncer_logfile }} {
    missingok
    compress
    notifempty
    sharedscripts
    create 0640 {{ pgbouncer_group }} {{ pgbouncer_user }}
    nodateext
    weekly
    rotate 5
    postrotate
        # SIGHUP makes every pgbouncer@ instance reopen its logfile
        systemctl kill -s HUP 'pgbouncer@*.service' 2> /dev/null || true
    endscript
}
